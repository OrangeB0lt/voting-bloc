{
  "name": "voting-bloc",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\""
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0"
    }
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@voting-bloc/eslint-config": "workspace:*",
    "@voting-bloc/tsconfig": "workspace:*",
    "prettier": "^3.0.0",
    "turbo": "latest"
  }
}
